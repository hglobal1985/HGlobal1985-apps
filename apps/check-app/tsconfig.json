{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": [
        "./src/*",
        "../../packages/ui/src/*"
      ],
      "@check/contract": [
        "../check-api/src/contract.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../../packages/ui/src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
