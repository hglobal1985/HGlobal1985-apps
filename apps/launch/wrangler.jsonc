{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "learn",
  // 固定部署到「寰宇（hglobal1985）」的 Cloudflare 帳號（杜杜龍 2026-11-27）：換任何 Claude 帳號或電腦，都只會部署到這個帳號；
  // 憑證沒有這個帳號的權限就直接失敗，不會在別的帳號另建一份。另一個生態系（例如 starry.phd）的 App 在自己的設定檔寫自己的帳號編號。
  "account_id": "650a3b03d439a5f517b4f8a28244f9fe",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [{ "pattern": "learn.hglobal1985.com", "custom_domain": true }],
  "alias": { "learn:static": "./.generated/static-files.js" },
  "d1_databases": [
    { "binding": "DB", "database_name": "learn-v2", "database_id": "f1283fdd-94f1-4a43-97b4-3072d1876ced", "migrations_dir": "migrations" }
  ],
  // Workers AI 綁定（逐字稿、關鍵字、語意搜尋）；用量由程式依「AI 模型」頁設定的每日上限控管。
  "ai": { "binding": "AI" },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "learn" }],
  // 兩個 App（行動大學、寰宇繳作業系統）共用的設定：上傳壓縮畫質（杜杜龍 2026-11-26；packages/server-shared/src/upload-settings.ts）。
  "kv_namespaces": [{ "binding": "SHARED", "id": "0287ee74946943298b5a7b7885930829" }],
  // Cloudflare Images 綁定：封面縮圖即時縮小（免費方案每月 5,000 次不重複縮圖，超過不收費、改回傳原圖；杜杜龍 2026-11-20）。
  "images": { "binding": "IMAGES" },
  // Cloudflare Email Service（網域 learn.hglobal1985.com 已開通寄信）；只用來寄通知，不需要金鑰。
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@learn.hglobal1985.com"] }],
  "vars": { "DEMO_LOGIN": "off", "EMAIL_FROM": "noreply@learn.hglobal1985.com", "CF_ACCOUNT_ID": "650a3b03d439a5f517b4f8a28244f9fe", "CF_ZONE_ID": "1c9558ed07ec981a87ff0f9a005ec9c4" },
  // MUX_SIGNING_KEY_ID 由杜杜龍在 Cloudflare 後台設定；部署時保留後台的變數，避免被清掉。
  "keep_vars": true,
  // 排程：每 10 分鐘補推還沒推播的通知；台灣時間 20:00 後發「明天開課提醒」（src/push.ts）。
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true }
}
