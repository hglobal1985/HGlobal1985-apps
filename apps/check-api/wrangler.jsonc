{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "check",
  // 固定部署到「寰宇（hglobal1985）」的 Cloudflare 帳號（杜杜龍 2026-11-27）：換任何 Claude 帳號或電腦，都只會部署到這個帳號；
  // 憑證沒有這個帳號的權限就直接失敗，不會在別的帳號另建一份。另一個生態系（例如 starry.phd）的 App 在自己的設定檔寫自己的帳號編號。
  "account_id": "650a3b03d439a5f517b4f8a28244f9fe",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [{ "pattern": "check.hglobal1985.com", "custom_domain": true }],
  "d1_databases": [{ "binding": "DB", "database_name": "check", "database_id": "fb4bbb9b-3919-4bc9-b302-e482da01d3cd", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "check" }],
  // 與行動大學共用的設定：上傳壓縮畫質（packages/server-shared/src/upload-settings.ts）。
  "kv_namespaces": [{ "binding": "SHARED", "id": "0287ee74946943298b5a7b7885930829" }],
  // App 網頁版（apps/check-app 用 expo export 產生）由 scripts/embed-static.mjs 打包進 Worker（雲端環境上傳靜態資源會被代理擋下，與行動大學同一做法）。
  "alias": { "check:static": "./.generated/static-files.js" },
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@learn.hglobal1985.com"] }],
  "vars": { "DEV_LOGIN": "off", "EMAIL_FROM": "noreply@learn.hglobal1985.com" },
  // CENTRAL_WEBHOOK_SECRET 由業主在 Cloudflare 後台設定；部署時保留後台的變數。
  "keep_vars": true,
  "triggers": { "crons": ["7 * * * *"] },
  "observability": { "enabled": true }
}
